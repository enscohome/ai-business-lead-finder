# ============================================
# AI Business Lead Finder - Environment Variables
# ============================================

# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.

# --------------------------------------------
# REQUIRED: Supabase (Database + Auth)
# --------------------------------------------
# Get these from your Supabase project dashboard:
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --------------------------------------------
# OPTIONAL: OpenAI (AI Sales Tools)
# --------------------------------------------
# Get from https://platform.openai.com/api-keys
# Without this, AI tools use template-based generation
OPENAI_API_KEY=sk-your-openai-key
NEXT_PUBLIC_OPENAI_ENABLED=false

# --------------------------------------------
# OPTIONAL: Google Maps (Maps Embed + Places API)
# --------------------------------------------
# Get from https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API + Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
GOOGLE_PLACES_API_KEY=your-google-places-key

# --------------------------------------------
# REQUIRED: App Configuration
# --------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------
# OPTIONAL: Stripe (Subscriptions)
# --------------------------------------------
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
